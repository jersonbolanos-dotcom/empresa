{
 "duration": 64.979184,
 "speech_end": 64.979,
 "segments": [
  {
   "i": 0,
   "s": 0.05,
   "e": 1.958,
   "s0": 0.05,
   "e0": 1.958,
   "text": "Vas en un tren a toda velocidad…"
  },
  {
   "i": 1,
   "s": 2.359,
   "e": 4.828,
   "s0": 2.359,
   "e0": 4.828,
   "text": "y la vía gira de golpe junto a un precipicio."
  },
  {
   "i": 2,
   "s": 5.479,
   "e": 6.433,
   "s0": 5.479,
   "e0": 6.433,
   "text": "¿Por qué no se sale?"
  },
  {
   "i": 3,
   "s": 6.966,
   "e": 9.436,
   "s0": 6.966,
   "e0": 9.436,
   "text": "El secreto está en algo que nunca has mirado."
  },
  {
   "i": 4,
   "s": 9.864,
   "e": 12.136,
   "s0": 9.864,
   "e0": 12.136,
   "text": "Pon un vaso de plástico a rodar sobre la mesa."
  },
  {
   "i": 5,
   "s": 12.594,
   "e": 13.393,
   "s0": 12.594,
   "e0": 13.393,
   "text": "No va recto:"
  },
  {
   "i": 6,
   "s": 13.746,
   "e": 14.733,
   "s0": 13.746,
   "e0": 14.733,
   "text": "gira en círculo…"
  },
  {
   "i": 7,
   "s": 15.056,
   "e": 17.415,
   "s0": 15.056,
   "e0": 17.415,
   "text": "porque una boca es más ancha que la otra."
  },
  {
   "i": 8,
   "s": 17.893,
   "e": 19.016,
   "s0": 17.893,
   "e0": 19.016,
   "text": "¿Y las ruedas del tren?"
  },
  {
   "i": 9,
   "s": 19.945,
   "e": 21.171,
   "s0": 19.645,
   "e0": 20.871,
   "text": "No son cilindros."
  },
  {
   "i": 10,
   "s": 21.462,
   "e": 24.054,
   "s0": 21.162,
   "e0": 23.754,
   "text": "Son ligeramente cónicas, como ese vaso."
  },
  {
   "i": 11,
   "s": 24.398,
   "e": 26.179,
   "s0": 24.098,
   "e0": 25.879,
   "text": "Y van unidas por un eje rígido:"
  },
  {
   "i": 12,
   "s": 26.5,
   "e": 28.472,
   "s0": 26.2,
   "e0": 28.172,
   "text": "las dos giran siempre a la vez."
  },
  {
   "i": 13,
   "s": 28.864,
   "e": 31.845,
   "s0": 28.564,
   "e0": 31.545,
   "text": "En la curva, el tren se corre un poquito hacia fuera…"
  },
  {
   "i": 14,
   "s": 32.16,
   "e": 35.096,
   "s0": 31.86,
   "e0": 34.796,
   "text": "así la rueda de fuera se apoya en su parte más ancha…"
  },
  {
   "i": 15,
   "s": 35.349,
   "e": 37.42,
   "s0": 35.049,
   "e0": 37.12,
   "text": "y recorre más camino en cada vuelta."
  },
  {
   "i": 16,
   "s": 37.728,
   "e": 39.59,
   "s0": 37.428,
   "e0": 39.29,
   "text": "La de dentro, en la más estrecha."
  },
  {
   "i": 17,
   "s": 40.01,
   "e": 40.675,
   "s0": 39.71,
   "e0": 40.375,
   "text": "Resultado:"
  },
  {
   "i": 18,
   "s": 40.989,
   "e": 42.214,
   "s0": 40.689,
   "e0": 41.914,
   "text": "el tren gira solo."
  },
  {
   "i": 19,
   "s": 42.54,
   "e": 43.158,
   "s0": 42.24,
   "e0": 42.858,
   "text": "Como el vaso."
  },
  {
   "i": 20,
   "s": 43.638,
   "e": 45.724,
   "s0": 43.338,
   "e0": 45.424,
   "text": "¿Y la pestaña, ese borde de la rueda?"
  },
  {
   "i": 21,
   "s": 46.081,
   "e": 49.136,
   "s0": 45.781,
   "e0": 48.836,
   "text": "Es solo un seguro por si algo falla, no lo que la guía."
  },
  {
   "i": 22,
   "s": 49.499,
   "e": 51.849,
   "s0": 49.199,
   "e0": 51.549,
   "text": "Además, en la curva la vía se inclina:"
  },
  {
   "i": 23,
   "s": 52.142,
   "e": 53.783,
   "s0": 51.842,
   "e0": 53.483,
   "text": "el riel de fuera va más alto."
  },
  {
   "i": 24,
   "s": 54.082,
   "e": 57.064,
   "s0": 53.782,
   "e0": 56.764,
   "text": "Es el peralte, y contrarresta el empujón hacia fuera."
  },
  {
   "i": 25,
   "s": 57.362,
   "e": 59.396,
   "s0": 57.062,
   "e0": 59.096,
   "text": "Así gira el tren junto al precipicio…"
  },
  {
   "i": 26,
   "s": 59.67,
   "e": 60.975,
   "s0": 59.37,
   "e0": 60.675,
   "text": "gracias a un cono."
  },
  {
   "i": 27,
   "s": 61.363,
   "e": 64.979,
   "s0": 61.063,
   "e0": 64.679,
   "text": "Envíaselo a ese amigo que siempre se agarra fuerte en las curvas."
  }
 ],
