{
 "duration": 61.664918,
 "speech_end": 61.665,
 "segments": [
  {
   "i": 0,
   "s": 0.05,
   "e": 1.288,
   "s0": 3.83,
   "e0": 5.068,
   "text": "Casi mil goles…"
  },
  {
   "i": 1,
   "s": 1.689,
   "e": 3.239,
   "s0": 5.469,
   "e0": 7.019,
   "text": "y era el más flaco del equipo."
  },
  {
   "i": 2,
   "s": 3.723,
   "e": 5.408,
   "s0": 11.734,
   "e0": 13.419,
   "text": "En Madeira lloraba si perdía."
  },
  {
   "i": 3,
   "s": 5.8,
   "e": 7.746,
   "s0": 13.811,
   "e0": 15.757,
   "text": "Si no le pasaban el balón, también."
  },
  {
   "i": 4,
   "s": 8.203,
   "e": 9.186,
   "s0": 16.214,
   "e0": 17.197,
   "text": "Y no era debilidad…"
  },
  {
   "i": 5,
   "s": 9.692,
   "e": 10.521,
   "s0": 17.703,
   "e0": 18.532,
   "text": "era rabia."
  },
  {
   "i": 6,
   "s": 11.069,
   "e": 13.929,
   "s0": 19.08,
   "e0": 21.94,
   "text": "A los 12 se fue a vivir a Lisboa, sin su familia."
  },
  {
   "i": 7,
   "s": 14.382,
   "e": 15.719,
   "s0": 22.393,
   "e0": 23.73,
   "text": "Lloró muchos días…"
  },
  {
   "i": 8,
   "s": 16.149,
   "e": 16.877,
   "s0": 24.16,
   "e0": 24.888,
   "text": "pero no volvió."
  },
  {
   "i": 9,
   "s": 17.264,
   "e": 20.827,
   "s0": 25.275,
   "e0": 28.838,
   "text": "Era el más flaco, así que se escapaba al gimnasio a hacer pesas."
  },
  {
   "i": 10,
   "s": 21.21,
   "e": 24.307,
   "s0": 29.221,
   "e0": 32.318,
   "text": "A los 15, su corazón empezó a ir demasiado rápido."
  },
  {
   "i": 11,
   "s": 24.732,
   "e": 25.386,
   "s0": 32.743,
   "e0": 33.397,
   "text": "Taquicardia."
  },
  {
   "i": 12,
   "s": 25.793,
   "e": 27.639,
   "s0": 33.804,
   "e0": 35.65,
   "text": "Lo operaron con láser por la mañana…"
  },
  {
   "i": 13,
   "s": 27.938,
   "e": 29.737,
   "s0": 35.949,
   "e0": 37.748,
   "text": "y por la tarde ya estaba en casa."
  },
  {
   "i": 14,
   "s": 30.125,
   "e": 32.052,
   "s0": 38.136,
   "e0": 40.063,
   "text": "A los pocos días, volvía a entrenar."
  },
  {
   "i": 15,
   "s": 32.477,
   "e": 34.062,
   "s0": 40.488,
   "e0": 42.073,
   "text": "Su secreto no es un truco."
  },
  {
   "i": 16,
   "s": 34.803,
   "e": 35.89,
   "s0": 42.414,
   "e0": 43.501,
   "text": "Es una alcancía."
  },
  {
   "i": 17,
   "s": 36.235,
   "e": 37.623,
   "s0": 43.846,
   "e0": 45.234,
   "text": "Cada día mete una moneda:"
  },
  {
   "i": 18,
   "s": 38.011,
   "e": 41.776,
   "s0": 45.622,
   "e0": 49.388,
   "text": "un entrenamiento extra, una comida limpia, una noche de sueño."
  },
  {
   "i": 19,
   "s": 42.078,
   "e": 45.85,
   "s0": 49.689,
   "e0": 53.461,
   "text": "Hasta duerme por ciclos de 90 minutos, unos cinco al día."
  },
  {
   "i": 20,
   "s": 47.08,
   "e": 49.352,
   "s0": 54.091,
   "e0": 56.363,
   "text": "Con 41 años sigue marcando."
  },
  {
   "i": 21,
   "s": 49.649,
   "e": 52.675,
   "s0": 56.66,
   "e0": 59.686,
   "text": "Ya van 985 goles oficiales."
  },
  {
   "i": 22,
   "s": 53.074,
   "e": 54.765,
   "s0": 60.085,
   "e0": 61.776,
   "text": "El talento te pone en el campo."
  },
  {
   "i": 23,
   "s": 55.088,
   "e": 57.525,
   "s0": 62.099,
   "e0": 64.536,
   "text": "La alcancía te mantiene 20 años."
  },
  {
   "i": 24,
   "s": 57.874,
   "e": 61.665,
   "s0": 64.885,
   "e0": 68.676,
   "text": "Envíaselo a ese amigo que dice que no nació con talento para nada."
  }
 ],
