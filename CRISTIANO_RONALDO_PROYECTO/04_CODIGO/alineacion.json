{
 "duration": 69.675918,
 "speech_end": 69.676,
 "segments": [
  {
   "i": 0,
   "s": 0.05,
   "e": 1.246,
   "text": "Le llamaban llorón…",
   "s0": 0.05,
   "e0": 1.246
  },
  {
   "i": 1,
   "s": 1.748,
   "e": 3.141,
   "text": "y nadie ha marcado más.",
   "s0": 1.748,
   "e0": 3.141
  },
  {
   "i": 2,
   "s": 3.83,
   "e": 5.068,
   "text": "Casi mil goles…",
   "s0": 3.83,
   "e0": 5.068
  },
  {
   "i": 3,
   "s": 5.469,
   "e": 7.019,
   "text": "y era el más flaco del equipo.",
   "s0": 5.469,
   "e0": 7.019
  },
  {
   "i": 4,
   "s": 7.578,
   "e": 9.479,
   "text": "Lo operaron del corazón a los 15…",
   "s0": 7.578,
   "e0": 9.479
  },
  {
   "i": 5,
   "s": 9.899,
   "e": 11.25,
   "text": "y nadie ha marcado más.",
   "s0": 9.899,
   "e0": 11.25
  },
  {
   "i": 6,
   "s": 11.734,
   "e": 13.419,
   "text": "En Madeira lloraba si perdía.",
   "s0": 11.734,
   "e0": 13.419
  },
  {
   "i": 7,
   "s": 13.811,
   "e": 15.757,
   "text": "Si no le pasaban el balón, también.",
   "s0": 13.811,
   "e0": 15.757
  },
  {
   "i": 8,
   "s": 16.214,
   "e": 17.197,
   "text": "Y no era debilidad…",
   "s0": 16.214,
   "e0": 17.197
  },
  {
   "i": 9,
   "s": 17.703,
   "e": 18.532,
   "text": "era rabia.",
   "s0": 17.703,
   "e0": 18.532
  },
  {
   "i": 10,
   "s": 19.08,
   "e": 21.94,
   "text": "A los 12 se fue a vivir a Lisboa, sin su familia.",
   "s0": 19.08,
   "e0": 21.94
  },
  {
   "i": 11,
   "s": 22.393,
   "e": 23.73,
   "text": "Lloró muchos días…",
   "s0": 22.393,
   "e0": 23.73
  },
  {
   "i": 12,
   "s": 24.16,
   "e": 24.888,
   "text": "pero no volvió.",
   "s0": 24.16,
   "e0": 24.888
  },
  {
   "i": 13,
   "s": 25.275,
   "e": 28.838,
   "text": "Era el más flaco, así que se escapaba al gimnasio a hacer pesas.",
   "s0": 25.275,
   "e0": 28.838
  },
  {
   "i": 14,
   "s": 29.221,
   "e": 32.318,
   "text": "A los 15, su corazón empezó a ir demasiado rápido.",
   "s0": 29.221,
   "e0": 32.318
  },
  {
   "i": 15,
   "s": 32.743,
   "e": 33.397,
   "text": "Taquicardia.",
   "s0": 32.743,
   "e0": 33.397
  },
  {
   "i": 16,
   "s": 33.804,
   "e": 35.65,
   "text": "Lo operaron con láser por la mañana…",
   "s0": 33.804,
   "e0": 35.65
  },
  {
   "i": 17,
   "s": 35.949,
   "e": 37.748,
   "text": "y por la tarde ya estaba en casa.",
   "s0": 35.949,
   "e0": 37.748
  },
  {
   "i": 18,
   "s": 38.136,
   "e": 40.063,
   "text": "A los pocos días, volvía a entrenar.",
   "s0": 38.136,
   "e0": 40.063
  },
  {
   "i": 19,
   "s": 40.488,
   "e": 42.073,
   "text": "Su secreto no es un truco.",
   "s0": 40.488,
   "e0": 42.073
  },
  {
   "i": 20,
   "s": 42.814,
   "e": 43.901,
   "text": "Es una alcancía.",
   "s0": 42.414,
   "e0": 43.501
  },
  {
   "i": 21,
   "s": 44.246,
   "e": 45.634,
   "text": "Cada día mete una moneda:",
   "s0": 43.846,
   "e0": 45.234
  },
  {
   "i": 22,
   "s": 46.022,
   "e": 49.788,
   "text": "un entrenamiento extra, una comida limpia, una noche de sueño.",
   "s0": 45.622,
   "e0": 49.388
  },
  {
   "i": 23,
   "s": 50.089,
   "e": 53.861,
   "text": "Hasta duerme por ciclos de 90 minutos, unos cinco al día.",
   "s0": 49.689,
   "e0": 53.461
  },
  {
   "i": 24,
   "s": 55.091,
   "e": 57.363,
   "text": "Con 41 años sigue marcando.",
   "s0": 54.091,
   "e0": 56.363
  },
  {
   "i": 25,
   "s": 57.66,
   "e": 60.686,
   "text": "Ya van 985 goles oficiales.",
   "s0": 56.66,
   "e0": 59.686
  },
  {
   "i": 26,
   "s": 61.085,
   "e": 62.776,
   "text": "El talento te pone en el campo.",
   "s0": 60.085,
   "e0": 61.776
  },
  {
   "i": 27,
   "s": 63.099,
   "e": 65.536,
   "text": "La alcancía te mantiene 20 años.",
   "s0": 62.099,
   "e0": 64.536
  },
  {
   "i": 28,
   "s": 65.885,
   "e": 69.676,
   "text": "Envíaselo a ese amigo que dice que no nació con talento para nada.",
   "s0": 64.885,
   "e0": 68.676
  }
 ],
