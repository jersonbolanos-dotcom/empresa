{
 "duration": 61.566918,
 "speech_end": 61.567,
 "segments": [
  {
   "i": 0,
   "s": 0.05,
   "e": 1.246,
   "s0": 0.05,
   "e0": 1.246,
   "text": "Le llamaban llorón…"
  },
  {
   "i": 1,
   "s": 1.748,
   "e": 3.141,
   "s0": 1.748,
   "e0": 3.141,
   "text": "y nadie ha marcado más."
  },
  {
   "i": 2,
   "s": 3.625,
   "e": 5.31,
   "s0": 11.734,
   "e0": 13.419,
   "text": "En Madeira lloraba si perdía."
  },
  {
   "i": 3,
   "s": 5.702,
   "e": 7.648,
   "s0": 13.811,
   "e0": 15.757,
   "text": "Si no le pasaban el balón, también."
  },
  {
   "i": 4,
   "s": 8.105,
   "e": 9.088,
   "s0": 16.214,
   "e0": 17.197,
   "text": "Y no era debilidad…"
  },
  {
   "i": 5,
   "s": 9.594,
   "e": 10.423,
   "s0": 17.703,
   "e0": 18.532,
   "text": "era rabia."
  },
  {
   "i": 6,
   "s": 10.971,
   "e": 13.831,
   "s0": 19.08,
   "e0": 21.94,
   "text": "A los 12 se fue a vivir a Lisboa, sin su familia."
  },
  {
   "i": 7,
   "s": 14.284,
   "e": 15.621,
   "s0": 22.393,
   "e0": 23.73,
   "text": "Lloró muchos días…"
  },
  {
   "i": 8,
   "s": 16.051,
   "e": 16.779,
   "s0": 24.16,
   "e0": 24.888,
   "text": "pero no volvió."
  },
  {
   "i": 9,
   "s": 17.166,
   "e": 20.729,
   "s0": 25.275,
   "e0": 28.838,
   "text": "Era el más flaco, así que se escapaba al gimnasio a hacer pesas."
  },
  {
   "i": 10,
   "s": 21.112,
   "e": 24.209,
   "s0": 29.221,
   "e0": 32.318,
   "text": "A los 15, su corazón empezó a ir demasiado rápido."
  },
  {
   "i": 11,
   "s": 24.634,
   "e": 25.288,
   "s0": 32.743,
   "e0": 33.397,
   "text": "Taquicardia."
  },
  {
   "i": 12,
   "s": 25.695,
   "e": 27.541,
   "s0": 33.804,
   "e0": 35.65,
   "text": "Lo operaron con láser por la mañana…"
  },
  {
   "i": 13,
   "s": 27.84,
   "e": 29.639,
   "s0": 35.949,
   "e0": 37.748,
   "text": "y por la tarde ya estaba en casa."
  },
  {
   "i": 14,
   "s": 30.027,
   "e": 31.954,
   "s0": 38.136,
   "e0": 40.063,
   "text": "A los pocos días, volvía a entrenar."
  },
  {
   "i": 15,
   "s": 32.379,
   "e": 33.964,
   "s0": 40.488,
   "e0": 42.073,
   "text": "Su secreto no es un truco."
  },
  {
   "i": 16,
   "s": 34.706,
   "e": 35.792,
   "s0": 42.414,
   "e0": 43.501,
   "text": "Es una alcancía."
  },
  {
   "i": 17,
   "s": 36.137,
   "e": 37.525,
   "s0": 43.846,
   "e0": 45.234,
   "text": "Cada día mete una moneda:"
  },
  {
   "i": 18,
   "s": 37.913,
   "e": 41.678,
   "s0": 45.622,
   "e0": 49.388,
   "text": "un entrenamiento extra, una comida limpia, una noche de sueño."
  },
  {
   "i": 19,
   "s": 41.98,
   "e": 45.752,
   "s0": 49.689,
   "e0": 53.461,
   "text": "Hasta duerme por ciclos de 90 minutos, unos cinco al día."
  },
  {
   "i": 20,
   "s": 46.982,
   "e": 49.254,
   "s0": 54.091,
   "e0": 56.363,
   "text": "Con 41 años sigue marcando."
  },
  {
   "i": 21,
   "s": 49.551,
   "e": 52.577,
   "s0": 56.66,
   "e0": 59.686,
   "text": "Ya van 985 goles oficiales."
  },
  {
   "i": 22,
   "s": 52.976,
   "e": 54.667,
   "s0": 60.085,
   "e0": 61.776,
   "text": "El talento te pone en el campo."
  },
  {
   "i": 23,
   "s": 54.99,
   "e": 57.427,
   "s0": 62.099,
   "e0": 64.536,
   "text": "La alcancía te mantiene 20 años."
  },
  {
   "i": 24,
   "s": 57.776,
   "e": 61.567,
   "s0": 64.885,
   "e0": 68.676,
   "text": "Envíaselo a ese amigo que dice que no nació con talento para nada."
  }
 ],
