{
 "duration": 66.429388,
 "speech_end": 66.429,
 "segments": [
  {
   "i": 0,
   "s": 0.05,
   "e": 1.216,
   "text": "Entre tus piernas…"
  },
  {
   "i": 1,
   "s": 1.467,
   "e": 3.598,
   "text": "hay una máquina que explota sin parar."
  },
  {
   "i": 2,
   "s": 4.168,
   "e": 5.172,
   "text": "¿Qué pasa ahí dentro?"
  },
  {
   "i": 3,
   "s": 5.907,
   "e": 8.134,
   "text": "Es más asombroso de lo que crees."
  },
  {
   "i": 4,
   "s": 8.71,
   "e": 9.712,
   "text": "Tu motor respira,"
  },
  {
   "i": 5,
   "s": 10.002,
   "e": 10.472,
   "text": "como tú,"
  },
  {
   "i": 6,
   "s": 10.824,
   "e": 11.974,
   "text": "en cuatro tiempos."
  },
  {
   "i": 7,
   "s": 12.418,
   "e": 15.922,
   "text": "Arriba, dos válvulas se abren y se cierran como una nariz."
  },
  {
   "i": 8,
   "s": 16.402,
   "e": 16.734,
   "text": "Uno:"
  },
  {
   "i": 9,
   "s": 17.063,
   "e": 17.596,
   "text": "aspira."
  },
  {
   "i": 10,
   "s": 17.925,
   "e": 20.451,
   "text": "El pistón baja y entra aire con gasolina."
  },
  {
   "i": 11,
   "s": 20.858,
   "e": 21.326,
   "text": "Dos:"
  },
  {
   "i": 12,
   "s": 21.621,
   "e": 22.224,
   "text": "aprieta."
  },
  {
   "i": 13,
   "s": 22.489,
   "e": 24.261,
   "text": "El pistón sube y lo comprime."
  },
  {
   "i": 14,
   "s": 24.717,
   "e": 25.138,
   "text": "Tres:"
  },
  {
   "i": 15,
   "s": 25.738,
   "e": 27.416,
   "text": "la bujía lanza una chispa…"
  },
  {
   "i": 16,
   "s": 27.947,
   "e": 28.748,
   "text": "y explota."
  },
  {
   "i": 17,
   "s": 29.079,
   "e": 31.382,
   "text": "La explosión empuja el pistón hacia abajo."
  },
  {
   "i": 18,
   "s": 31.823,
   "e": 32.245,
   "text": "Cuatro:"
  },
  {
   "i": 19,
   "s": 32.522,
   "e": 33.03,
   "text": "sopla."
  },
  {
   "i": 20,
   "s": 33.366,
   "e": 34.899,
   "text": "El humo sale por el escape."
  },
  {
   "i": 21,
   "s": 35.402,
   "e": 39.159,
   "text": "La biela y el cigüeñal convierten ese sube y baja en giro,"
  },
  {
   "i": 22,
   "s": 39.413,
   "e": 41.763,
   "text": "como tus piernas en los pedales de una bicicleta."
  },
  {
   "i": 23,
   "s": 42.055,
   "e": 44.936,
   "text": "Y la cadena lleva ese giro a la rueda de atrás."
  },
  {
   "i": 24,
   "s": 45.483,
   "e": 46.655,
   "text": "Ahora, el dato."
  },
  {
   "i": 25,
   "s": 48.112,
   "e": 52.209,
   "text": "A unas seis mil vueltas por minuto, con una explosión cada dos vueltas…"
  },
  {
   "i": 26,
   "s": 52.512,
   "e": 55.21,
   "text": "son cincuenta explosiones cada segundo."
  },
  {
   "i": 27,
   "s": 55.529,
   "e": 56.322,
   "text": "Tres mil…"
  },
  {
   "i": 28,
   "s": 56.645,
   "e": 57.46,
   "text": "cada minuto."
  },
  {
   "i": 29,
   "s": 57.788,
   "e": 59.169,
   "text": "Cincuenta por segundo…"
  },
  {
   "i": 30,
   "s": 59.441,
   "e": 62.775,
   "text": "mientras vas al trabajo, llevas un pedido o vuelves a casa."
  },
  {
   "i": 31,
   "s": 63.128,
   "e": 66.429,
   "text": "Envíaselo a ese amigo que se gana la vida en dos ruedas."
  }
 ],
