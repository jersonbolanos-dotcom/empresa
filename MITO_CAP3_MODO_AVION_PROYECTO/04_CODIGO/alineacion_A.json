{
 "duration": 50.200449,
 "speech_end": 50.2,
 "segments": [
  {
   "i": 0,
   "s": 0.05,
   "e": 2.551,
   "s0": 0.05,
   "e0": 2.551,
   "text": "Pones el modo avión para que cargue más rápido."
  },
  {
   "i": 1,
   "s": 3.093,
   "e": 4.202,
   "s0": 9.055,
   "e0": 10.164,
   "text": "¿Mito o verdad?"
  },
  {
   "i": 2,
   "s": 4.783,
   "e": 6.544,
   "s0": 10.745,
   "e0": 12.506,
   "text": "Piensa en tu batería como un balde,"
  },
  {
   "i": 3,
   "s": 6.799,
   "e": 9.039,
   "s0": 12.761,
   "e0": 15.001,
   "text": "y en el cargador como la manguera que lo llena."
  },
  {
   "i": 4,
   "s": 9.418,
   "e": 11.044,
   "s0": 15.38,
   "e0": 17.006,
   "text": "Pero el balde tiene agujeros:"
  },
  {
   "i": 5,
   "s": 11.361,
   "e": 15.478,
   "s0": 17.323,
   "e0": 21.44,
   "text": "la red móvil, el wifi y el bluetooth gastan energía todo el tiempo."
  },
  {
   "i": 6,
   "s": 15.912,
   "e": 16.714,
   "s0": 21.874,
   "e0": 22.676,
   "text": "El modo avión…"
  },
  {
   "i": 7,
   "s": 17.136,
   "e": 18.328,
   "s0": 23.098,
   "e0": 24.29,
   "text": "tapa esos agujeros."
  },
  {
   "i": 8,
   "s": 18.733,
   "e": 21.101,
   "s0": 24.695,
   "e0": 27.063,
   "text": "Y si tienes poca señal, el agujero crece:"
  },
  {
   "i": 9,
   "s": 21.425,
   "e": 24.342,
   "s0": 27.387,
   "e0": 30.304,
   "text": "tu celular grita más fuerte para que la antena lo escuche."
  },
  {
   "i": 10,
   "s": 24.781,
   "e": 26.524,
   "s0": 30.743,
   "e0": 32.486,
   "text": "Entonces, ¿carga más rápido?"
  },
  {
   "i": 11,
   "s": 26.869,
   "e": 27.28,
   "s0": 32.831,
   "e0": 33.242,
   "text": "Sí…"
  },
  {
   "i": 12,
   "s": 27.726,
   "e": 31.2,
   "s0": 33.688,
   "e0": 37.162,
   "text": "pero los agujeros son pequeños, y la manguera es enorme."
  },
  {
   "i": 13,
   "s": 31.563,
   "e": 36.785,
   "s0": 37.525,
   "e0": 42.747,
   "text": "En las pruebas publicadas, la diferencia fue de solo unos minutos, en cargas de más de una hora."
  },
  {
   "i": 14,
   "s": 38.066,
   "e": 38.767,
   "s0": 43.428,
   "e0": 44.129,
   "text": "Veredicto:"
  },
  {
   "i": 15,
   "s": 39.21,
   "e": 39.861,
   "s0": 44.572,
   "e0": 45.223,
   "text": "a medias."
  },
  {
   "i": 16,
   "s": 40.256,
   "e": 43.768,
   "s0": 45.618,
   "e0": 49.13,
   "text": "Puede notarse un poco más con mala señal o con un cargador lento."
  },
  {
   "i": 17,
   "s": 44.146,
   "e": 45.783,
   "s0": 49.508,
   "e0": 51.145,
   "text": "Con uno rápido, casi nada."
  },
  {
   "i": 18,
   "s": 46.168,
   "e": 50.2,
   "s0": 51.529,
   "e0": 55.562,
   "text": "Envíaselo a ese amigo que pone el modo avión cada vez que enchufa el celular."
  }
 ],
