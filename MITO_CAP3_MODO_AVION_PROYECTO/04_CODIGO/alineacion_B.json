{
 "duration": 49.790449,
 "speech_end": 49.79,
 "segments": [
  {
   "i": 0,
   "s": 0.05,
   "e": 2.141,
   "s0": 3.234,
   "e0": 5.325,
   "text": "El truco del modo avión tiene trampa."
  },
  {
   "i": 1,
   "s": 2.683,
   "e": 3.792,
   "s0": 9.055,
   "e0": 10.164,
   "text": "¿Mito o verdad?"
  },
  {
   "i": 2,
   "s": 4.373,
   "e": 6.134,
   "s0": 10.745,
   "e0": 12.506,
   "text": "Piensa en tu batería como un balde,"
  },
  {
   "i": 3,
   "s": 6.389,
   "e": 8.629,
   "s0": 12.761,
   "e0": 15.001,
   "text": "y en el cargador como la manguera que lo llena."
  },
  {
   "i": 4,
   "s": 9.008,
   "e": 10.634,
   "s0": 15.38,
   "e0": 17.006,
   "text": "Pero el balde tiene agujeros:"
  },
  {
   "i": 5,
   "s": 10.951,
   "e": 15.068,
   "s0": 17.323,
   "e0": 21.44,
   "text": "la red móvil, el wifi y el bluetooth gastan energía todo el tiempo."
  },
  {
   "i": 6,
   "s": 15.502,
   "e": 16.304,
   "s0": 21.874,
   "e0": 22.676,
   "text": "El modo avión…"
  },
  {
   "i": 7,
   "s": 16.726,
   "e": 17.918,
   "s0": 23.098,
   "e0": 24.29,
   "text": "tapa esos agujeros."
  },
  {
   "i": 8,
   "s": 18.323,
   "e": 20.691,
   "s0": 24.695,
   "e0": 27.063,
   "text": "Y si tienes poca señal, el agujero crece:"
  },
  {
   "i": 9,
   "s": 21.015,
   "e": 23.932,
   "s0": 27.387,
   "e0": 30.304,
   "text": "tu celular grita más fuerte para que la antena lo escuche."
  },
  {
   "i": 10,
   "s": 24.371,
   "e": 26.114,
   "s0": 30.743,
   "e0": 32.486,
   "text": "Entonces, ¿carga más rápido?"
  },
  {
   "i": 11,
   "s": 26.459,
   "e": 26.87,
   "s0": 32.831,
   "e0": 33.242,
   "text": "Sí…"
  },
  {
   "i": 12,
   "s": 27.316,
   "e": 30.79,
   "s0": 33.688,
   "e0": 37.162,
   "text": "pero los agujeros son pequeños, y la manguera es enorme."
  },
  {
   "i": 13,
   "s": 31.153,
   "e": 36.375,
   "s0": 37.525,
   "e0": 42.747,
   "text": "En las pruebas publicadas, la diferencia fue de solo unos minutos, en cargas de más de una hora."
  },
  {
   "i": 14,
   "s": 37.656,
   "e": 38.357,
   "s0": 43.428,
   "e0": 44.129,
   "text": "Veredicto:"
  },
  {
   "i": 15,
   "s": 38.8,
   "e": 39.451,
   "s0": 44.572,
   "e0": 45.223,
   "text": "a medias."
  },
  {
   "i": 16,
   "s": 39.846,
   "e": 43.358,
   "s0": 45.618,
   "e0": 49.13,
   "text": "Puede notarse un poco más con mala señal o con un cargador lento."
  },
  {
   "i": 17,
   "s": 43.736,
   "e": 45.373,
   "s0": 49.508,
   "e0": 51.145,
   "text": "Con uno rápido, casi nada."
  },
  {
   "i": 18,
   "s": 45.758,
   "e": 49.79,
   "s0": 51.529,
   "e0": 55.562,
   "text": "Envíaselo a ese amigo que pone el modo avión cada vez que enchufa el celular."
  }
 ],
