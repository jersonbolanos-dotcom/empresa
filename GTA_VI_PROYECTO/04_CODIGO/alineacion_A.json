{
 "duration": 61.16602,
 "speech_end": 61.166,
 "segments": [
  {
   "i": 0,
   "s": 0.05,
   "e": 2.526,
   "s0": 0.05,
   "e0": 2.526,
   "text": "Llevas 13 años esperando un videojuego."
  },
  {
   "i": 1,
   "s": 3.129,
   "e": 5.236,
   "s0": 10.594,
   "e0": 12.701,
   "text": "GTA V salió en 2013."
  },
  {
   "i": 2,
   "s": 5.622,
   "e": 8.21,
   "s0": 13.087,
   "e0": 15.675,
   "text": "Si tenías 10 años, hoy tienes 23."
  },
  {
   "i": 3,
   "s": 8.653,
   "e": 11.749,
   "s0": 16.118,
   "e0": 19.215,
   "text": "Ese mismo juego salió en tres generaciones de consolas."
  },
  {
   "i": 4,
   "s": 12.168,
   "e": 13.226,
   "s0": 19.633,
   "e0": 20.691,
   "text": "Y GTA VI…"
  },
  {
   "i": 5,
   "s": 13.988,
   "e": 14.721,
   "s0": 21.053,
   "e0": 21.786,
   "text": "no llegaba."
  },
  {
   "i": 6,
   "s": 15.184,
   "e": 16.218,
   "s0": 22.249,
   "e0": 23.283,
   "text": "No es que no lo hicieran."
  },
  {
   "i": 7,
   "s": 16.558,
   "e": 18.149,
   "s0": 23.623,
   "e0": 25.214,
   "text": "Es que no se programa un juego:"
  },
  {
   "i": 8,
   "s": 18.462,
   "e": 20.176,
   "s0": 25.527,
   "e0": 27.241,
   "text": "se construye un país."
  },
  {
   "i": 9,
   "s": 20.622,
   "e": 21.216,
   "s0": 27.687,
   "e0": 28.281,
   "text": "Leonida,"
  },
  {
   "i": 10,
   "s": 21.519,
   "e": 25.477,
   "s0": 28.584,
   "e0": 32.542,
   "text": "un estado inventado inspirado en Florida, con Vice City como gran ciudad."
  },
  {
   "i": 11,
   "s": 25.82,
   "e": 31.257,
   "s0": 32.885,
   "e0": 38.322,
   "text": "Cada calle, cada tienda, cada palmera la diseñan miles de personas en varios países."
  },
  {
   "i": 12,
   "s": 31.581,
   "e": 34.793,
   "s0": 38.646,
   "e0": 41.858,
   "text": "Y cuando en diciembre de 2023 salió su primer tráiler,"
  },
  {
   "i": 13,
   "s": 35.069,
   "e": 35.94,
   "s0": 42.134,
   "e0": 43.005,
   "text": "hizo historia:"
  },
  {
   "i": 14,
   "s": 36.31,
   "e": 39.311,
   "s0": 43.375,
   "e0": 46.376,
   "text": "90 millones de visitas en 24 horas."
  },
  {
   "i": 15,
   "s": 39.701,
   "e": 42.955,
   "s0": 46.766,
   "e0": 50.02,
   "text": "Ningún juego se había presentado ante tanta gente en YouTube."
  },
  {
   "i": 16,
   "s": 43.373,
   "e": 45.701,
   "s0": 50.438,
   "e0": 52.766,
   "text": "Y aun así lo retrasaron dos veces…"
  },
  {
   "i": 17,
   "s": 46.084,
   "e": 46.792,
   "s0": 53.149,
   "e0": 53.857,
   "text": "para pulirlo."
  },
  {
   "i": 18,
   "s": 48.03,
   "e": 49.335,
   "s0": 54.495,
   "e0": 55.8,
   "text": "Ahora sí tiene fecha:"
  },
  {
   "i": 19,
   "s": 49.708,
   "e": 52.825,
   "s0": 56.173,
   "e0": 59.29,
   "text": "sale el 19 de noviembre de 2026."
  },
  {
   "i": 20,
   "s": 53.155,
   "e": 54.381,
   "s0": 59.62,
   "e0": 60.846,
   "text": "Trece años después…"
  },
  {
   "i": 21,
   "s": 54.658,
   "e": 56.007,
   "s0": 61.123,
   "e0": 62.472,
   "text": "vuelves a Vice City."
  },
  {
   "i": 22,
   "s": 56.358,
   "e": 61.166,
   "s0": 62.823,
   "e0": 67.631,
   "text": "Envíaselo a ese amigo que lleva desde 2013 diciendo «este año sí sale»."
  }
 ],
