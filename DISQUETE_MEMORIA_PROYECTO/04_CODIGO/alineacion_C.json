{
 "duration": 62.495653,
 "speech_end": 62.496,
 "segments": [
  {
   "i": 0,
   "s": 0.05,
   "e": 1.277,
   "s0": 0.05,
   "e0": 1.277,
   "text": "Todos tus disquetes…"
  },
  {
   "i": 1,
   "s": 1.63,
   "e": 2.915,
   "s0": 1.63,
   "e0": 2.915,
   "text": "hoy caben en una uña."
  },
  {
   "i": 2,
   "s": 3.4,
   "e": 4.779,
   "s0": 3.4,
   "e0": 4.779,
   "text": "¿Cómo pasamos de esto…"
  },
  {
   "i": 3,
   "s": 5.239,
   "e": 5.823,
   "s0": 5.239,
   "e0": 5.823,
   "text": "a esto?"
  },
  {
   "i": 4,
   "s": 6.615,
   "e": 9.038,
   "s0": 6.615,
   "e0": 9.038,
   "text": "La respuesta está en algo que no se ve."
  },
  {
   "i": 5,
   "s": 9.587,
   "e": 13.516,
   "s0": 9.587,
   "e0": 13.516,
   "text": "¿Te acuerdas del ruidito del lector… y del temido «disco lleno»?"
  },
  {
   "i": 6,
   "s": 14.003,
   "e": 16.484,
   "s0": 14.003,
   "e0": 16.484,
   "text": "Un disquete guardaba un poco más de un mega."
  },
  {
   "i": 7,
   "s": 16.889,
   "e": 19.154,
   "s0": 16.889,
   "e0": 19.154,
   "text": "Por dentro era una biblioteca redonda:"
  },
  {
   "i": 8,
   "s": 19.536,
   "e": 23.004,
   "s0": 19.536,
   "e0": 23.004,
   "text": "un disco con imán que giraba, y una cabeza que corría encima,"
  },
  {
   "i": 9,
   "s": 23.296,
   "e": 25.87,
   "s0": 23.296,
   "e0": 25.87,
   "text": "leyendo y escribiendo puntitos magnéticos."
  },
  {
   "i": 10,
   "s": 26.266,
   "e": 27.12,
   "s0": 26.266,
   "e0": 27.12,
   "text": "Todo se movía…"
  },
  {
   "i": 11,
   "s": 27.494,
   "e": 28.294,
   "s0": 27.494,
   "e0": 28.294,
   "text": "por eso sonaba,"
  },
  {
   "i": 12,
   "s": 28.622,
   "e": 30.254,
   "s0": 28.622,
   "e0": 30.254,
   "text": "y por eso podía dañarse."
  },
  {
   "i": 13,
   "s": 30.712,
   "e": 32.873,
   "s0": 30.712,
   "e0": 32.873,
   "text": "Tu tarjeta de hoy es otra biblioteca…"
  },
  {
   "i": 14,
   "s": 33.139,
   "e": 34.475,
   "s0": 33.139,
   "e0": 34.475,
   "text": "pero sin nada que gire."
  },
  {
   "i": 15,
   "s": 34.858,
   "e": 39.689,
   "s0": 34.858,
   "e0": 39.689,
   "text": "Son miles de millones de cajoncitos diminutos que guardan electricidad encerrada."
  },
  {
   "i": 16,
   "s": 40.072,
   "e": 43.206,
   "s0": 40.072,
   "e0": 43.206,
   "text": "Se encogieron tanto que ya no podían achicarse más."
  },
  {
   "i": 17,
   "s": 43.623,
   "e": 47.386,
   "s0": 43.623,
   "e0": 47.386,
   "text": "Así que los apilaron, como un edificio de más de cien pisos."
  },
  {
   "i": 18,
   "s": 47.86,
   "e": 51.222,
   "s0": 47.86,
   "e0": 51.222,
   "text": "¿Cuántos disquetes caben en una tarjeta de quinientos doce gigas?"
  },
  {
   "i": 19,
   "s": 51.822,
   "e": 53.563,
   "s0": 53.039,
   "e0": 54.78,
   "text": "Más de trescientos mil."
  },
  {
   "i": 20,
   "s": 53.948,
   "e": 56.981,
   "s0": 55.165,
   "e0": 58.198,
   "text": "Apilados, serían una torre de más de un kilómetro."
  },
  {
   "i": 21,
   "s": 57.366,
   "e": 58.185,
   "s0": 58.583,
   "e0": 59.402,
   "text": "Y todo eso…"
  },
  {
   "i": 22,
   "s": 58.467,
   "e": 59.328,
   "s0": 59.684,
   "e0": 60.545,
   "text": "en una uña."
  },
  {
   "i": 23,
   "s": 59.759,
   "e": 62.496,
   "s0": 60.976,
   "e0": 63.713,
   "text": "Envíaselo a ese amigo que aún guarda sus disquetes."
  }
 ],
