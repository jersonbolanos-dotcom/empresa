{
 "duration": 52.114286,
 "speech_end": 52.114,
 "segments": [
  {
   "i": 0,
   "s": 0.05,
   "e": 1.413,
   "text": "Deslizas hacia arriba…"
  },
  {
   "i": 1,
   "s": 1.783,
   "e": 3.401,
   "text": "y cierras todas tus apps."
  },
  {
   "i": 2,
   "s": 3.861,
   "e": 5.513,
   "text": "¿Cerrarlas ahorra batería?"
  },
  {
   "i": 3,
   "s": 6.031,
   "e": 6.402,
   "text": "¿Mito"
  },
  {
   "i": 4,
   "s": 6.678,
   "e": 7.203,
   "text": "o verdad?"
  },
  {
   "i": 5,
   "s": 8.217,
   "e": 10.015,
   "text": "Piensa en un libro con marcapáginas."
  },
  {
   "i": 6,
   "s": 10.427,
   "e": 13.667,
   "text": "Cuando sales de una app, tu celular no la deja funcionando:"
  },
  {
   "i": 7,
   "s": 13.997,
   "e": 14.775,
   "text": "la congela,"
  },
  {
   "i": 8,
   "s": 15.028,
   "e": 16.762,
   "text": "justo en la página donde ibas."
  },
  {
   "i": 9,
   "s": 17.132,
   "e": 19.095,
   "text": "Congelada, no usa el procesador…"
  },
  {
   "i": 10,
   "s": 19.462,
   "e": 20.858,
   "text": "casi no gasta batería."
  },
  {
   "i": 11,
   "s": 21.234,
   "e": 23.719,
   "text": "Lo dicen Apple y Google en sus páginas de ayuda."
  },
  {
   "i": 12,
   "s": 24.105,
   "e": 25.388,
   "text": "Pero si la cierras…"
  },
  {
   "i": 13,
   "s": 26.266,
   "e": 28.952,
   "text": "es como cerrar el libro y tirar el marcapáginas."
  },
  {
   "i": 14,
   "s": 29.312,
   "e": 32.316,
   "text": "La próxima vez, tu celular tiene que abrirla desde cero,"
  },
  {
   "i": 15,
   "s": 32.612,
   "e": 34.227,
   "text": "y eso le cuesta más trabajo."
  },
  {
   "i": 16,
   "s": 34.576,
   "e": 35.633,
   "text": "Así que cerrarla"
  },
  {
   "i": 17,
   "s": 36.296,
   "e": 37.883,
   "text": "puede gastar MÁS batería,"
  },
  {
   "i": 18,
   "s": 38.19,
   "e": 38.868,
   "text": "no menos."
  },
  {
   "i": 19,
   "s": 39.777,
   "e": 40.465,
   "text": "Veredicto:"
  },
  {
   "i": 20,
   "s": 40.874,
   "e": 41.413,
   "text": "mito."
  },
  {
   "i": 21,
   "s": 41.869,
   "e": 44.024,
   "text": "Solo vale la pena cerrarla si se traba…"
  },
  {
   "i": 22,
   "s": 44.317,
   "e": 48.158,
   "text": "o si usa la ubicación o la música de fondo y ya no la necesitas."
  },
  {
   "i": 23,
   "s": 48.524,
   "e": 52.114,
   "text": "Envíaselo a ese amigo que cierra todas sus apps cada noche."
  }
 ],
