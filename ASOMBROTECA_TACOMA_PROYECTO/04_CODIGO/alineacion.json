{
 "duration": 104.124063,
 "speech_end": 103.899,
 "segments": [
  {
   "i": 0,
   "s": 0.05,
   "e": 2.634,
   "text": "El 7 de noviembre de 1940"
  },
  {
   "i": 1,
   "s": 2.943,
   "e": 7.249,
   "text": "un puente gigantesco comenzó a retorcerse como si estuviera hecho de goma."
  },
  {
   "i": 2,
   "s": 7.858,
   "e": 8.925,
   "text": "No hubo terremoto."
  },
  {
   "i": 3,
   "s": 9.383,
   "e": 12.405,
   "text": "Y el viento ni siquiera era el más fuerte que había soportado."
  },
  {
   "i": 4,
   "s": 12.911,
   "e": 13.697,
   "text": "Pero ese día,"
  },
  {
   "i": 5,
   "s": 14.164,
   "e": 16.093,
   "text": "el puente terminó desplomándose."
  },
  {
   "i": 6,
   "s": 16.69,
   "e": 17.701,
   "text": "¿Cómo pudo ocurrir?"
  },
  {
   "i": 7,
   "s": 18.209,
   "e": 21.079,
   "text": "Era el puente de Tacoma Narrows, en Estados Unidos."
  },
  {
   "i": 8,
   "s": 21.526,
   "e": 24.224,
   "text": "Había sido inaugurado apenas cuatro meses antes."
  },
  {
   "i": 9,
   "s": 24.636,
   "e": 27.149,
   "text": "Y desde el principio, algo extraño sucedía."
  },
  {
   "i": 10,
   "s": 27.611,
   "e": 32.233,
   "text": "Cuando soplaba el viento, la carretera subía y bajaba formando enormes ondas."
  },
  {
   "i": 11,
   "s": 32.685,
   "e": 35.05,
   "text": "Pero el verdadero peligro estaba en su diseño."
  },
  {
   "i": 12,
   "s": 35.482,
   "e": 40.662,
   "text": "Su tablero era largo, estrecho, y demasiado flexible frente a ciertos movimientos."
  },
  {
   "i": 13,
   "s": 41.073,
   "e": 46.709,
   "text": "Además, sus grandes vigas laterales modificaban la forma en que el aire circulaba alrededor del puente."
  },
  {
   "i": 14,
   "s": 47.172,
   "e": 49.354,
   "text": "Entonces llegó el momento decisivo."
  },
  {
   "i": 15,
   "s": 49.754,
   "e": 51.581,
   "text": "El tablero comenzó a retorcerse."
  },
  {
   "i": 16,
   "s": 51.977,
   "e": 54.206,
   "text": "Un borde subía mientras el otro bajaba."
  },
  {
   "i": 17,
   "s": 54.629,
   "e": 56.9,
   "text": "Y aquí, ocurrió algo extraordinario."
  },
  {
   "i": 18,
   "s": 57.322,
   "e": 60.322,
   "text": "Al girar, el puente cambiaba el flujo del viento."
  },
  {
   "i": 19,
   "s": 60.769,
   "e": 64.394,
   "text": "Ese flujo producía nuevas fuerzas que podían reforzar el giro."
  },
  {
   "i": 20,
   "s": 64.815,
   "e": 67.066,
   "text": "Cada oscilación recibía más energía."
  },
  {
   "i": 21,
   "s": 67.491,
   "e": 70.146,
   "text": "En lugar de detenerse, el movimiento crecía."
  },
  {
   "i": 22,
   "s": 70.592,
   "e": 74.286,
   "text": "Los ingenieros llaman a este fenómeno inestabilidad aeroelástica."
  },
  {
   "i": 23,
   "s": 74.721,
   "e": 80.175,
   "text": "El puente terminó retorciéndose tanto, que partes de su estructura no pudieron soportar las fuerzas."
  },
  {
   "i": 24,
   "s": 80.573,
   "e": 82.97,
   "text": "Y el tablero, se rompió y cayó al agua."
  },
  {
   "i": 25,
   "s": 83.472,
   "e": 86.708,
   "text": "Aquel desastre cambió para siempre la ingeniería de los puentes."
  },
  {
   "i": 26,
   "s": 87.109,
   "e": 92.076,
   "text": "Desde entonces, comprender cómo interactúan el viento y las estructuras se volvió fundamental."
  },
  {
   "i": 27,
   "s": 92.525,
   "e": 95.786,
   "text": "Porque a veces, el mayor peligro no es la fuerza del viento."
  },
  {
   "i": 28,
   "s": 96.213,
   "e": 100.02,
   "text": "Sino lo que esa fuerza, puede hacer que una estructura empiece a hacer."
  },
  {
   "i": 29,
   "s": 100.569,
   "e": 101.472,
   "text": "Asombroteca."
  },
  {
   "i": 30,
   "s": 101.846,
   "e": 103.899,
   "text": "La ciencia oculta de lo imposible."
  }
 ],
