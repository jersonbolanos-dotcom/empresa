{
 "duration": 64.952816,
 "speech_end": 64.651,
 "segments": [
  {
   "i": 0,
   "s": 0.05,
   "e": 1.982,
   "s0": 0.05,
   "e0": 1.982,
   "text": "Estás frente al televisor de tu abuela…"
  },
  {
   "i": 1,
   "s": 2.439,
   "e": 3.894,
   "s0": 2.439,
   "e0": 3.894,
   "text": "y te está disparando."
  },
  {
   "i": 2,
   "s": 4.348,
   "e": 5.188,
   "s0": 4.348,
   "e0": 5.188,
   "text": "¿Cómo funcionaba?"
  },
  {
   "i": 3,
   "s": 5.877,
   "e": 8.269,
   "s0": 5.877,
   "e0": 8.269,
   "text": "Lo que pasaba por dentro te va a sorprender."
  },
  {
   "i": 4,
   "s": 8.768,
   "e": 12.301,
   "s0": 8.768,
   "e0": 12.301,
   "text": "Al fondo del tubo, un cañón dispara electrones hacia la pantalla…"
  },
  {
   "i": 5,
   "s": 12.734,
   "e": 13.269,
   "s0": 13.336,
   "e0": 13.871,
   "text": "hacia ti."
  },
  {
   "i": 6,
   "s": 13.739,
   "e": 15.592,
   "s0": 14.341,
   "e0": 16.194,
   "text": "Como pintar una pared con una manguera…"
  },
  {
   "i": 7,
   "s": 15.871,
   "e": 17.105,
   "s0": 16.473,
   "e0": 17.707,
   "text": "línea por línea."
  },
  {
   "i": 8,
   "s": 17.516,
   "e": 21.08,
   "s0": 18.118,
   "e0": 21.682,
   "text": "Unos imanes mueven el chorro de lado a lado y de arriba abajo."
  },
  {
   "i": 9,
   "s": 21.583,
   "e": 25.342,
   "s0": 22.185,
   "e0": 25.944,
   "text": "Barre más de quinientas líneas, decenas de veces por segundo…"
  },
  {
   "i": 10,
   "s": 25.69,
   "e": 27.285,
   "s0": 26.292,
   "e0": 27.887,
   "text": "y tu ojo ve una imagen."
  },
  {
   "i": 11,
   "s": 27.693,
   "e": 30.057,
   "s0": 28.295,
   "e0": 30.659,
   "text": "El fósforo de la pantalla brilla donde le pega…"
  },
  {
   "i": 12,
   "s": 30.424,
   "e": 32.162,
   "s0": 31.026,
   "e0": 32.764,
   "text": "como la pintura donde cae el agua."
  },
  {
   "i": 13,
   "s": 32.567,
   "e": 34.486,
   "s0": 33.169,
   "e0": 35.088,
   "text": "En los de color hay tres mangueras:"
  },
  {
   "i": 14,
   "s": 34.87,
   "e": 36.661,
   "s0": 35.472,
   "e0": 37.263,
   "text": "rojo, verde y azul."
  },
  {
   "i": 15,
   "s": 37.081,
   "e": 39.456,
   "s0": 37.683,
   "e0": 40.058,
   "text": "¿Y por qué eran tan pesados y profundos?"
  },
  {
   "i": 16,
   "s": 40.414,
   "e": 43.057,
   "s0": 40.616,
   "e0": 43.259,
   "text": "Porque por dentro el tubo está al vacío."
  },
  {
   "i": 17,
   "s": 43.452,
   "e": 45.082,
   "s0": 43.654,
   "e0": 45.284,
   "text": "El aire lo aprieta desde afuera…"
  },
  {
   "i": 18,
   "s": 45.419,
   "e": 47.693,
   "s0": 45.621,
   "e0": 47.895,
   "text": "y el vidrio tenía que ser gruesísimo."
  },
  {
   "i": 19,
   "s": 48.066,
   "e": 51.487,
   "s0": 48.268,
   "e0": 51.69,
   "text": "Y el chorro puede necesitar espacio para abrirse hasta las esquinas."
  },
  {
   "i": 20,
   "s": 51.885,
   "e": 55.877,
   "s0": 52.087,
   "e0": 56.079,
   "text": "Toda esa imagen… era un solo puntito pintando a toda velocidad."
  },
  {
   "i": 21,
   "s": 56.409,
   "e": 57.513,
   "s0": 57.337,
   "e0": 58.441,
   "text": "nunca lo abras;"
  },
  {
   "i": 22,
   "s": 57.834,
   "e": 60.735,
   "s0": 58.762,
   "e0": 61.663,
   "text": "aun desconectado puede guardar electricidad peligrosa."
  },
  {
   "i": 23,
   "s": 61.162,
   "e": 64.651,
   "s0": 62.09,
   "e0": 65.579,
   "text": "Envíaselo a ese amigo que todavía le da golpecitos al televisor."
  }
 ],
