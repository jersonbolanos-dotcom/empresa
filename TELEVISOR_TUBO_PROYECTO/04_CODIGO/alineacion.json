{
 "duration": 66.280816,
 "speech_end": 65.979,
 "segments": [
  {
   "i": 0,
   "s": 0.05,
   "e": 1.982,
   "text": "Estás frente al televisor de tu abuela…",
   "s0": 0.05,
   "e0": 1.982
  },
  {
   "i": 1,
   "s": 2.439,
   "e": 3.894,
   "text": "y te está disparando.",
   "s0": 2.439,
   "e0": 3.894
  },
  {
   "i": 2,
   "s": 4.348,
   "e": 5.188,
   "text": "¿Cómo funcionaba?",
   "s0": 4.348,
   "e0": 5.188
  },
  {
   "i": 3,
   "s": 5.877,
   "e": 8.269,
   "text": "Lo que pasaba por dentro te va a sorprender.",
   "s0": 5.877,
   "e0": 8.269
  },
  {
   "i": 4,
   "s": 8.768,
   "e": 12.301,
   "text": "Al fondo del tubo, un cañón dispara electrones hacia la pantalla…",
   "s0": 8.768,
   "e0": 12.301
  },
  {
   "i": 5,
   "s": 12.704,
   "e": 13.076,
   "text": "o sea,",
   "s0": 12.704,
   "e0": 13.076
  },
  {
   "i": 6,
   "s": 13.336,
   "e": 13.871,
   "text": "hacia ti.",
   "s0": 13.336,
   "e0": 13.871
  },
  {
   "i": 7,
   "s": 14.341,
   "e": 16.194,
   "text": "Como pintar una pared con una manguera…",
   "s0": 14.341,
   "e0": 16.194
  },
  {
   "i": 8,
   "s": 16.473,
   "e": 17.707,
   "text": "línea por línea.",
   "s0": 16.473,
   "e0": 17.707
  },
  {
   "i": 9,
   "s": 18.118,
   "e": 21.682,
   "text": "Unos imanes mueven el chorro de lado a lado y de arriba abajo.",
   "s0": 18.118,
   "e0": 21.682
  },
  {
   "i": 10,
   "s": 22.185,
   "e": 25.944,
   "text": "Barre más de quinientas líneas, decenas de veces por segundo…",
   "s0": 22.185,
   "e0": 25.944
  },
  {
   "i": 11,
   "s": 26.292,
   "e": 27.887,
   "text": "y tu ojo ve una imagen.",
   "s0": 26.292,
   "e0": 27.887
  },
  {
   "i": 12,
   "s": 28.295,
   "e": 30.659,
   "text": "El fósforo de la pantalla brilla donde le pega…",
   "s0": 28.295,
   "e0": 30.659
  },
  {
   "i": 13,
   "s": 31.026,
   "e": 32.764,
   "text": "como la pintura donde cae el agua.",
   "s0": 31.026,
   "e0": 32.764
  },
  {
   "i": 14,
   "s": 33.169,
   "e": 35.088,
   "text": "En los de color hay tres mangueras:",
   "s0": 33.169,
   "e0": 35.088
  },
  {
   "i": 15,
   "s": 35.472,
   "e": 37.263,
   "text": "rojo, verde y azul.",
   "s0": 35.472,
   "e0": 37.263
  },
  {
   "i": 16,
   "s": 37.683,
   "e": 40.058,
   "text": "¿Y por qué eran tan pesados y profundos?",
   "s0": 37.683,
   "e0": 40.058
  },
  {
   "i": 17,
   "s": 41.016,
   "e": 43.659,
   "text": "Porque por dentro el tubo está al vacío.",
   "s0": 40.616,
   "e0": 43.259
  },
  {
   "i": 18,
   "s": 44.054,
   "e": 45.684,
   "text": "El aire lo aprieta desde afuera…",
   "s0": 43.654,
   "e0": 45.284
  },
  {
   "i": 19,
   "s": 46.021,
   "e": 48.295,
   "text": "y el vidrio tenía que ser gruesísimo.",
   "s0": 45.621,
   "e0": 47.895
  },
  {
   "i": 20,
   "s": 48.668,
   "e": 52.09,
   "text": "Y el chorro puede necesitar espacio para abrirse hasta las esquinas.",
   "s0": 48.268,
   "e0": 51.69
  },
  {
   "i": 21,
   "s": 52.487,
   "e": 56.479,
   "text": "Toda esa imagen… era un solo puntito pintando a toda velocidad.",
   "s0": 52.087,
   "e0": 56.079
  },
  {
   "i": 22,
   "s": 56.981,
   "e": 57.445,
   "text": "Eso sí:",
   "s0": 56.581,
   "e0": 57.045
  },
  {
   "i": 23,
   "s": 57.737,
   "e": 58.841,
   "text": "nunca lo abras;",
   "s0": 57.337,
   "e0": 58.441
  },
  {
   "i": 24,
   "s": 59.162,
   "e": 62.063,
   "text": "aun desconectado puede guardar electricidad peligrosa.",
   "s0": 58.762,
   "e0": 61.663
  },
  {
   "i": 25,
   "s": 62.49,
   "e": 65.979,
   "text": "Envíaselo a ese amigo que todavía le da golpecitos al televisor.",
   "s0": 62.09,
   "e0": 65.579
  }
 ],
