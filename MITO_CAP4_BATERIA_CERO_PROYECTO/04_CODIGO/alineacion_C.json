{
 "duration": 51.630449,
 "speech_end": 51.63,
 "segments": [
  {
   "i": 0,
   "s": 0.05,
   "e": 3.413,
   "s0": 7.822,
   "e0": 11.185,
   "text": "Cuando marca 0 % tu batería no está vacía."
  },
  {
   "i": 1,
   "s": 3.926,
   "e": 5.129,
   "s0": 11.698,
   "e0": 12.901,
   "text": "¿Mito o verdad?"
  },
  {
   "i": 2,
   "s": 5.516,
   "e": 7.733,
   "s0": 13.288,
   "e0": 15.505,
   "text": "El consejo viene de las baterías de níquel:"
  },
  {
   "i": 3,
   "s": 8.027,
   "e": 11.088,
   "s0": 15.799,
   "e0": 18.86,
   "text": "si no las vaciabas, «olvidaban» parte de su carga."
  },
  {
   "i": 4,
   "s": 11.421,
   "e": 12.713,
   "s0": 19.193,
   "e0": 20.485,
   "text": "Era el efecto memoria."
  },
  {
   "i": 5,
   "s": 13.041,
   "e": 15.399,
   "s0": 20.813,
   "e0": 23.171,
   "text": "Pero tu celular usa una batería de litio…"
  },
  {
   "i": 6,
   "s": 15.815,
   "e": 17.787,
   "s0": 23.587,
   "e0": 25.559,
   "text": "y el litio no tiene esa memoria."
  },
  {
   "i": 7,
   "s": 18.159,
   "e": 20.147,
   "s0": 25.931,
   "e0": 27.919,
   "text": "Piensa en ella como una goma elástica:"
  },
  {
   "i": 8,
   "s": 20.494,
   "e": 22.192,
   "s0": 28.266,
   "e0": 29.964,
   "text": "usarla en el medio no la daña."
  },
  {
   "i": 9,
   "s": 22.536,
   "e": 26.315,
   "s0": 30.308,
   "e0": 34.087,
   "text": "Lo que la agrieta es llevarla a los extremos, una y otra vez."
  },
  {
   "i": 10,
   "s": 26.646,
   "e": 29.693,
   "s0": 34.418,
   "e0": 37.465,
   "text": "Por eso tu celular se apaga antes de vaciarse del todo:"
  },
  {
   "i": 11,
   "s": 29.999,
   "e": 31.979,
   "s0": 37.771,
   "e0": 39.751,
   "text": "guarda una reserva para protegerse."
  },
  {
   "i": 12,
   "s": 32.336,
   "e": 34.489,
   "s0": 40.108,
   "e0": 42.261,
   "text": "Y si la dejas llegar a cero muy seguido…"
  },
  {
   "i": 13,
   "s": 34.874,
   "e": 36.438,
   "s0": 42.646,
   "e0": 44.21,
   "text": "se desgasta más rápido."
  },
  {
   "i": 14,
   "s": 37.663,
   "e": 38.374,
   "s0": 45.435,
   "e0": 46.146,
   "text": "Veredicto:"
  },
  {
   "i": 15,
   "s": 38.728,
   "e": 39.242,
   "s0": 46.5,
   "e0": 47.014,
   "text": "mito."
  },
  {
   "i": 16,
   "s": 39.675,
   "e": 41.05,
   "s0": 47.447,
   "e0": 48.822,
   "text": "Cárgala cuando quieras."
  },
  {
   "i": 17,
   "s": 41.371,
   "e": 47.484,
   "s0": 49.143,
   "e0": 55.256,
   "text": "Y si tu celular te deja limitar la carga al 80 % como algunos de Apple y de Google, mejor todavía."
  },
  {
   "i": 18,
   "s": 47.77,
   "e": 51.63,
   "s0": 55.542,
   "e0": 59.402,
   "text": "Envíaselo a ese amigo que espera a que el celular se apague para cargarlo."
  }
 ],
