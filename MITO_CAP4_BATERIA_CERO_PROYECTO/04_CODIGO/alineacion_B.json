{
 "duration": 51.401449,
 "speech_end": 51.401,
 "segments": [
  {
   "i": 0,
   "s": 0.05,
   "e": 1.84,
   "s0": 4.127,
   "e0": 5.917,
   "text": "El consejo de tu tío era bueno…"
  },
  {
   "i": 1,
   "s": 2.329,
   "e": 3.184,
   "s0": 6.406,
   "e0": 7.261,
   "text": "en los noventa."
  },
  {
   "i": 2,
   "s": 3.697,
   "e": 4.9,
   "s0": 11.698,
   "e0": 12.901,
   "text": "¿Mito o verdad?"
  },
  {
   "i": 3,
   "s": 5.287,
   "e": 7.504,
   "s0": 13.288,
   "e0": 15.505,
   "text": "El consejo viene de las baterías de níquel:"
  },
  {
   "i": 4,
   "s": 7.798,
   "e": 10.859,
   "s0": 15.799,
   "e0": 18.86,
   "text": "si no las vaciabas, «olvidaban» parte de su carga."
  },
  {
   "i": 5,
   "s": 11.192,
   "e": 12.484,
   "s0": 19.193,
   "e0": 20.485,
   "text": "Era el efecto memoria."
  },
  {
   "i": 6,
   "s": 12.812,
   "e": 15.17,
   "s0": 20.813,
   "e0": 23.171,
   "text": "Pero tu celular usa una batería de litio…"
  },
  {
   "i": 7,
   "s": 15.586,
   "e": 17.558,
   "s0": 23.587,
   "e0": 25.559,
   "text": "y el litio no tiene esa memoria."
  },
  {
   "i": 8,
   "s": 17.93,
   "e": 19.918,
   "s0": 25.931,
   "e0": 27.919,
   "text": "Piensa en ella como una goma elástica:"
  },
  {
   "i": 9,
   "s": 20.265,
   "e": 21.963,
   "s0": 28.266,
   "e0": 29.964,
   "text": "usarla en el medio no la daña."
  },
  {
   "i": 10,
   "s": 22.307,
   "e": 26.086,
   "s0": 30.308,
   "e0": 34.087,
   "text": "Lo que la agrieta es llevarla a los extremos, una y otra vez."
  },
  {
   "i": 11,
   "s": 26.417,
   "e": 29.464,
   "s0": 34.418,
   "e0": 37.465,
   "text": "Por eso tu celular se apaga antes de vaciarse del todo:"
  },
  {
   "i": 12,
   "s": 29.77,
   "e": 31.75,
   "s0": 37.771,
   "e0": 39.751,
   "text": "guarda una reserva para protegerse."
  },
  {
   "i": 13,
   "s": 32.107,
   "e": 34.261,
   "s0": 40.108,
   "e0": 42.261,
   "text": "Y si la dejas llegar a cero muy seguido…"
  },
  {
   "i": 14,
   "s": 34.645,
   "e": 36.209,
   "s0": 42.646,
   "e0": 44.21,
   "text": "se desgasta más rápido."
  },
  {
   "i": 15,
   "s": 37.434,
   "e": 38.145,
   "s0": 45.435,
   "e0": 46.146,
   "text": "Veredicto:"
  },
  {
   "i": 16,
   "s": 38.499,
   "e": 39.013,
   "s0": 46.5,
   "e0": 47.014,
   "text": "mito."
  },
  {
   "i": 17,
   "s": 39.446,
   "e": 40.821,
   "s0": 47.447,
   "e0": 48.822,
   "text": "Cárgala cuando quieras."
  },
  {
   "i": 18,
   "s": 41.142,
   "e": 47.255,
   "s0": 49.143,
   "e0": 55.256,
   "text": "Y si tu celular te deja limitar la carga al 80 % como algunos de Apple y de Google, mejor todavía."
  },
  {
   "i": 19,
   "s": 47.541,
   "e": 51.401,
   "s0": 55.542,
   "e0": 59.402,
   "text": "Envíaselo a ese amigo que espera a que el celular se apague para cargarlo."
  }
 ],
