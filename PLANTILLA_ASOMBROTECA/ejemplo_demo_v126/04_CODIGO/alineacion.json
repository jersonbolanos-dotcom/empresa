{
 "duration": 40.219167,
 "speech_end": 40.219,
 "segments": [
  {
   "i": 0,
   "s": 0.05,
   "e": 2.144,
   "text": "¿Por qué un café te quita el sueño?"
  },
  {
   "i": 1,
   "s": 2.508,
   "e": 3.683,
   "text": "No te da energía."
  },
  {
   "i": 2,
   "s": 4.424,
   "e": 14.81,
   "text": "Le hace trampa a tu cerebro. Mientras estás despierto, tus neuronas acumulan adenosina, la molécula del cansancio. Cuanta más hay, más encaja en sus cerraduras,"
  },
  {
   "i": 3,
   "s": 15.182,
   "e": 19.035,
   "text": "y más sueño te da. La cafeína tiene casi la misma forma."
  },
  {
   "i": 4,
   "s": 19.415,
   "e": 20.836,
   "text": "Entra en esas cerraduras,"
  },
  {
   "i": 5,
   "s": 21.527,
   "e": 27.208,
   "text": "pero no las abre. Así que el cansancio sigue ahí, esperando su turno. Y no se va rápido."
  },
  {
   "i": 6,
   "s": 28.001,
   "e": 33.939,
   "text": "Cinco horas después, la mitad de la cafeína sigue en tu sangre. Si te lo tomas a las cinco de la tarde,"
  },
  {
   "i": 7,
   "s": 34.532,
   "e": 40.219,
   "text": "a las diez de la noche aún te queda la mitad. Envíaselo a ese amigo que dice que el café no le afecta."
  }
 ],
