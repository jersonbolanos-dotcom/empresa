{
 "duration": 70.509286,
 "speech_end": 70.509,
 "segments": [
  {
   "i": 0,
   "s": 0.05,
   "e": 1.721,
   "s0": 0.05,
   "e0": 1.721,
   "text": "Estás en la orilla de un río…"
  },
  {
   "i": 1,
   "s": 2.291,
   "e": 4.474,
   "s0": 2.291,
   "e0": 4.474,
   "text": "y dos ojos te miran desde el agua."
  },
  {
   "i": 2,
   "s": 5.096,
   "e": 7.885,
   "s0": 5.096,
   "e0": 7.885,
   "text": "Y la razón por la que siguen ahí te va a sorprender."
  },
  {
   "i": 3,
   "s": 8.441,
   "e": 9.774,
   "s0": 8.441,
   "e0": 9.774,
   "text": "Piensa en una cuchara."
  },
  {
   "i": 4,
   "s": 10.235,
   "e": 11.346,
   "s0": 12.32,
   "e0": 13.431,
   "text": "porque ya funciona."
  },
  {
   "i": 5,
   "s": 11.873,
   "e": 13.65,
   "s0": 13.958,
   "e0": 15.735,
   "text": "Al cocodrilo le pasó lo mismo."
  },
  {
   "i": 6,
   "s": 14.131,
   "e": 17.655,
   "s0": 16.216,
   "e0": 19.74,
   "text": "Hace doscientos millones de años, cuando vivían los dinosaurios,"
  },
  {
   "i": 7,
   "s": 17.923,
   "e": 20.485,
   "s0": 20.008,
   "e0": 22.57,
   "text": "ya había cocodrilos muy parecidos a este."
  },
  {
   "i": 8,
   "s": 20.926,
   "e": 22.666,
   "s0": 23.011,
   "e0": 24.751,
   "text": "Y su arma ya estaba lista:"
  },
  {
   "i": 9,
   "s": 23.159,
   "e": 26.19,
   "s0": 25.244,
   "e0": 28.275,
   "text": "la mordida más fuerte jamás medida en un animal."
  },
  {
   "i": 10,
   "s": 26.704,
   "e": 27.878,
   "s0": 28.789,
   "e0": 29.963,
   "text": "Sí ha evolucionado…"
  },
  {
   "i": 11,
   "s": 28.265,
   "e": 29.543,
   "s0": 30.35,
   "e0": 31.628,
   "text": "pero muy despacio."
  },
  {
   "i": 12,
   "s": 29.992,
   "e": 30.751,
   "s0": 32.077,
   "e0": 32.836,
   "text": "Como tu cuchara:"
  },
  {
   "i": 13,
   "s": 31.07,
   "e": 32.566,
   "s0": 33.155,
   "e0": 34.651,
   "text": "solo cambian los detalles."
  },
  {
   "i": 14,
   "s": 33.039,
   "e": 36.27,
   "s0": 35.124,
   "e0": 38.355,
   "text": "Hace sesenta y seis millones de años cayó el asteroide."
  },
  {
   "i": 15,
   "s": 36.744,
   "e": 38.405,
   "s0": 38.829,
   "e0": 40.49,
   "text": "Los dinosaurios desaparecieron…"
  },
  {
   "i": 16,
   "s": 38.805,
   "e": 40.603,
   "s0": 40.89,
   "e0": 42.688,
   "text": "y el cocodrilo siguió nadando."
  },
  {
   "i": 17,
   "s": 41.093,
   "e": 42.023,
   "s0": 43.178,
   "e0": 44.108,
   "text": "¿Cómo sobrevivió?"
  },
  {
   "i": 18,
   "s": 42.735,
   "e": 44.356,
   "s0": 44.82,
   "e0": 46.441,
   "text": "Primero, la sangre fría:"
  },
  {
   "i": 19,
   "s": 44.848,
   "e": 47.769,
   "s0": 46.933,
   "e0": 49.853,
   "text": "el sol lo calienta, así que come mucho menos…"
  },
  {
   "i": 20,
   "s": 48.035,
   "e": 49.913,
   "s0": 50.12,
   "e0": 51.998,
   "text": "y puede pasar meses sin comer."
  },
  {
   "i": 21,
   "s": 50.414,
   "e": 50.969,
   "s0": 52.499,
   "e0": 53.054,
   "text": "Segundo,"
  },
  {
   "i": 22,
   "s": 51.389,
   "e": 54.725,
   "s0": 53.474,
   "e0": 56.81,
   "text": "vive entre el agua y la tierra y come casi de todo:"
  },
  {
   "i": 23,
   "s": 55.173,
   "e": 56.887,
   "s0": 57.258,
   "e0": 58.972,
   "text": "así vivían los que sobrevivieron."
  },
  {
   "i": 24,
   "s": 57.39,
   "e": 57.968,
   "s0": 59.475,
   "e0": 60.053,
   "text": "Y tercero,"
  },
  {
   "i": 25,
   "s": 58.396,
   "e": 61.961,
   "s0": 60.481,
   "e0": 64.046,
   "text": "su cuerpo ya funcionaba tan bien que no necesitaba cambiar."
  },
  {
   "i": 26,
   "s": 62.445,
   "e": 66.556,
   "s0": 64.53,
   "e0": 68.641,
   "text": "Por eso hoy, en tu río, nada uno casi igual que entonces."
  },
  {
   "i": 27,
   "s": 67.04,
   "e": 70.509,
   "s0": 69.125,
   "e0": 72.594,
   "text": "Envíaselo a ese amigo al que le encantan los dinosaurios."
  }
 ],
